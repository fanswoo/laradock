# PowerSync self-hosted configuration

replication:
  connections:
    - type: mysql
      uri: !env PS_MYSQL_URI
      # 說明：
      #   - config schema 要求 replication.connections 是 array，不可寫成 replication.type/uri
      #     （錯誤寫法 log 會照常顯示 "Replication Engine Successfully started"，但註冊 0 個 replicator）
      #   - 實際 URI 由 /var/laradock/.env 的 PS_MYSQL_URI 提供
      #   - PowerSync 僅支援 !env 替換整個值（無字串插值），且變數名必須以 PS_ 開頭
      #   - powersync_user 需先在 MySQL 建立（見 server-config.md 1-3）

logging:
  level: debug
  format: json

storage:
  type: mongodb
  uri: "mongodb://powersync_mongo:27017/powersync?replicaSet=rs0"
  # replicaSet=rs0：PowerSync 的 multi-document transactions 要求 RS 模式（見 docker-compose）
  # 不可加 directConnection=true：會讓 driver 當 standalone 處理連線，導致 mongo 以 RS member
  # 身份拒絕 direct write，出現 NotWritablePrimary 錯誤

# Client authentication
client_auth:
  jwks_uri: "https://cowork-style.local/api/message/powersync/.well-known/jwks.json"
  # 走 HTTPS (port 443) 才會命中 cowork-style.conf 的 vhost；
  # hostname cowork-style.local 由 docker-compose nginx aliases 解析到 nginx 容器
  audience:
    - "https://cowork-style.local"
  # 必須與 PowerSyncAuthController::token() 簽發 JWT 時的 aud claim 一致

# 每一條同步連線的兩個上限（powersync-service 1.26.1 的 api.parameters，沒有設定時都是 1000）：
#   - max_parameter_query_results：這條連線所有參數查詢傳回的列數加總
#   - max_buckets_per_connection：這條連線上不重複的 bucket 數
# 超過任何一個，服務就以 [PSYNC_S2305] 結束整條連線，這條連線上的每一條 stream 都同步不到
# （sync-streams.yaml 2026-10-16 的備忘）。每一段聊天對話經 my_conversations 與 my_participants
# 佔兩個參數查詢結果與兩個 bucket，所以在預設上限下，大約有 500 段聊天對話的人就連不上。
# 數值與後端 docker/sail/powersync/config.yaml 相同（後端 docs/powersync/live-service.md 的規則 9）。
# 服務只在啟動時讀這個檔案。
api:
  parameters:
    max_parameter_query_results: 5000
    max_buckets_per_connection: 5000

# Sync Streams（指定同步規則檔案路徑）
sync_rules:
  path: /config/sync-streams.yaml

# Port
port: 8080
